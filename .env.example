# AppObras - Variáveis de Ambiente
# Copie este ficheiro para .env e preencha os valores

# ==================== DATABASE ====================
# TiDB Cloud Connection String
# Formato: mysql://user:password@host:port/database?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql://user:password@gateway01.region.prod.aws.tidbcloud.com:4000/appobras?ssl={"rejectUnauthorized":true}

# ==================== AUTH ====================
# Chave secreta para JWT (gere uma string aleatória)
JWT_SECRET=your-super-secret-jwt-key-change-this

# ID do proprietário do sistema (OpenID do admin)
OWNER_OPEN_ID=

# ==================== EMAIL (Opcional) ====================
# Configuração do Resend para envio de emails
RESEND_API_KEY=
EMAIL_FROM=noreply@appobras.com

# ==================== STORAGE (Opcional) ====================
# Cloudflare R2 ou AWS S3 para armazenamento de ficheiros
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=appobras
S3_PUBLIC_URL=

# ==================== PUSH NOTIFICATIONS (Opcional) ====================
# Web Push VAPID Keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@appobras.com

# ==================== ANALYTICS (Opcional) ====================
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
